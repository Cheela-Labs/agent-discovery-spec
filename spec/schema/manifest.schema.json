{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-discovery-spec.org/schema/0.1.0/manifest.schema.json",
  "title": "Agent Discovery Specification — Capability Manifest",
  "description": "Normative schema for the ADS Core capability manifest. See spec/02-manifest-schema.md for field-by-field prose.",
  "type": "object",
  "required": ["specVersion", "id", "name", "provider", "capabilities"],
  "additionalProperties": true,
  "properties": {
    "specVersion": {
      "type": "string",
      "description": "The ADS Core version this manifest conforms to.",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "id": {
      "type": "string",
      "description": "Stable identifier for the system. SHOULD be reverse-DNS style or a URN. MUST NOT change across revisions.",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "provider": {
      "$ref": "#/$defs/provider"
    },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" }
    },
    "discovery": {
      "$ref": "#/$defs/discovery"
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced, additive data outside ADS Core. See spec/05-extensibility.md.",
      "additionalProperties": true
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time",
      "description": "Advisory only — not a substitute for discovery.cacheTtlSeconds or HTTP caching."
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "namespacedName": {
      "type": "string",
      "description": "Reverse-DNS style namespaced name, e.g. com.example.lookupOrder. The namespace portion is compared case-insensitively (DNS semantics); the leaf segment MAY use camelCase. See spec/05-extensibility.md.",
      "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}(\\.[A-Za-z][A-Za-z0-9-]{0,63})+$"
    },
    "provider": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "contact": { "type": "string" }
      }
    },
    "capability": {
      "type": "object",
      "required": ["name", "version", "endpoint"],
      "additionalProperties": true,
      "properties": {
        "name": { "$ref": "#/$defs/namespacedName" },
        "version": { "$ref": "#/$defs/semver" },
        "description": { "type": "string" },
        "inputSchema": { "type": "object" },
        "outputSchema": { "type": "object" },
        "endpoint": { "$ref": "#/$defs/endpoint" },
        "deprecated": { "type": "boolean", "default": false },
        "deprecatedSince": { "$ref": "#/$defs/semver" },
        "removalNotBefore": { "$ref": "#/$defs/semver" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "deprecated": { "const": true } },
            "required": ["deprecated"]
          },
          "then": { "required": ["deprecatedSince"] }
        }
      ]
    },
    "endpoint": {
      "type": "object",
      "required": ["transport", "address", "auth"],
      "additionalProperties": true,
      "properties": {
        "transport": {
          "type": "string",
          "description": "Well-known: http, grpc, mcp, queue. Open string — unrecognized values MUST be skipped by clients, not treated as invalid.",
          "minLength": 1
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "auth": {
          "type": "string",
          "description": "Well-known: none, apiKey, oauth2, mtls. Custom schemes MUST use a custom: prefix.",
          "minLength": 1
        },
        "authDetails": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "cacheTtlSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "signature": {
          "type": "object",
          "additionalProperties": true,
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": { "type": "string" },
            "value": { "type": "string" },
            "keyUrl": { "type": "string", "format": "uri" }
          }
        }
      }
    }
  }
}
